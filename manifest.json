{
  "manifest_version": 3,
  "name": "Bíblia Online",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "description": "Leia a Bíblia online em português e inglês. Navegação rápida e intuitiva entre livros e capítulos.",
  "author": "Luis Guilherme Rampaso",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_title": "Bíblia Online",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://bible-api.com/*", "https://api.getbible.net/*"]
}